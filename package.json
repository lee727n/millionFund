{
  "name": "fund-app",
  "private": true,
  "version": "1.10.0",
  "description": "AI百万资产 - 安卓 + Windows 双端全品种资产管理工具，支持基金/股票/加密货币/可转债实时估值、持仓管理、AI调仓追踪",
  "author": {
    "name": "millionFund",
    "email": "fund@millionFund.app"
  },
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:android": "node scripts/build-all-platforms.mjs android",
    "build:windows": "node scripts/build-all-platforms.mjs windows",
    "build:all": "node scripts/build-all-platforms.mjs all",
    "preview": "vite preview",
    "lint": "eslint src/**/*.{ts,vue}",
    "lint:fix": "eslint src/**/*.{ts,vue} --fix",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "update-funds": "node scripts/fetch-fund-list.mjs",
    "cap:init": "npx cap init",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npm run build && npx cap copy",
    "cap:sync:android": "npm run build && npx cap copy android && npx cap sync android",
    "cap:open:android": "npx cap open android",
    "electron:dev": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "@capacitor-community/http": "^1.4.1",
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/camera": "^8.2.1",
    "@capacitor/core": "^8.4.1",
    "chart.js": "^4.5.1",
    "lightweight-charts": "^5.2.0",
    "pinia": "^3.0.4",
    "tesseract.js": "^7.0.0",
    "vant": "^4.10.0",
    "vue": "^3.5.39",
    "vue-chartjs": "^5.3.4",
    "vue-i18n": "^11.4.6",
    "vue-router": "^5.1.0",
    "vue-virtual-scroller": "^3.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@pinia/testing": "^1.0.3",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@vant/auto-import-resolver": "^1.3.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.9.2",
    "happy-dom": "^20.10.6",
    "playwright": "^1.61.1",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.7"
  },
  "build": {
    "appId": "com.fundapp.realtime",
    "productName": "AI百万资产",
    "copyright": "MIT License",
    "directories": {
      "output": "release/desktop"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI百万实盘"
    }
  }
}
