# 百万基金 App 环境变量配置

# ========== API 配置 ==========

# 天天基金 API 基础 URL（可选，默认使用内置代理）
# VITE_TIANTIANAPI_BASE_URL=https://api.fund.eastmoney.com

# 新闻 API 基础 URL（可选）
# VITE_NEWS_API_URL=https://your-news-api.com

# ========== WebSocket 配置 ==========

# WebSocket 服务器 URL（用于实时推送指数更新）
# 如果不配置，则不使用 WebSocket 实时推送
# 开发环境示例：
# VITE_WS_URL=ws://localhost:3001
# 生产环境示例：
# VITE_WS_URL=wss://your-websocket-server.com/ws

# ========== 功能开关 ==========

# 是否启用 PWA（离线支持）
# VITE_PWA_ENABLED=true

# 是否启用调试日志
# VITE_DEBUG=false

# ========== 其他配置 ==========

# 应用标题
# VITE_APP_TITLE=百万基金

# 应用版本
# VITE_APP_VERSION=1.0.0
